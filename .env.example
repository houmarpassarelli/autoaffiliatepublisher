# .env.example
# Copie para .env e ajuste os valores. O arquivo .env nunca é versionado:
# ele concentra as credenciais que, por decisão arquitetural, jamais saem
# da máquina administrativa (ARQUITETURA.md, Seção 6 — Thin Client).

# --- Aplicação ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# --- Infraestrutura local (ver docker-compose.yml) ---
# MONGODB_PORT é a porta publicada no host. Altere-a (e a porta em MONGODB_URI)
# caso a máquina já tenha outro MongoDB ocupando a porta padrão.
MONGODB_PORT=27017
MONGODB_DATABASE=auto_affiliate_publisher
MONGODB_URI=mongodb://localhost:27017/auto_affiliate_publisher
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Origens autorizadas dos dois dashboards (CORS), separadas por vírgula ---
CORS_ORIGINS=http://localhost:5180,http://localhost:5181

# --- Política anti-spam da fila de disparos ---
# Intervalo Δ do delay progressivo, em milissegundos.
# Valor de referência inicial: 3 minutos (180000). O levantamento de mercado
# registrado no DOSSIE.md indica que 30 a 60 minutos preservam melhor a audiência.
# Decisão operacional em aberto (CHECKLIST.md, Categoria 8).
DISPATCH_INTERVAL_MS=180000

# --- Tempo real (WebSocket) ---
# Janela de tolerância do heartbeat. Conexões silenciosas por mais tempo que isto
# são encerradas e a presença do operador é liberada na tela-portão.
WEBSOCKET_HEARTBEAT_TIMEOUT_MS=90000
