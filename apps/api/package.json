{
  "name": "@aap/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend único do Auto Affiliate Publisher: HTTP, WebSocket, ingestão, IA, fila e drivers de disparo.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aap/shared": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.5",
    "openai": "^7.13.0",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
